# ==============================================================================
# AI-Based Early Warning & Landslide Risk Monitoring System in NER
# Environment Configuration Template
# Copy this file to .env and customize for local deployment
# ==============================================================================

# Application Settings
PROJECT_NAME="NER Landslide Early Warning & Risk Monitoring System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite default for local development)
DATABASE_PATH="data/landslide_system.db"

# Machine Learning Service Configuration
ML_MODEL_DIR="backend/ml_engine/models"
SPATIAL_MODEL_FILENAME="landslide_rf_model.joblib"
METADATA_FILENAME="model_metadata.json"

# Early Warning Thresholds (Default empirical values, calibrated in Phase 2)
RAINFALL_YELLOW_THRESHOLD_MM=40.0
RAINFALL_ORANGE_THRESHOLD_MM=75.0
RAINFALL_RED_THRESHOLD_MM=120.0
SOIL_MOISTURE_CRITICAL_PCT=80.0

# External Integrations (Optional / Stubs for future extension)
IMD_WEATHER_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMS_SENDER_NUMBER=""
