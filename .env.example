# =====================================================================
# NER Landslide Early Warning & Risk Monitoring System
# Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# Project & Runtime Environment
PROJECT_NAME="NER Landslide Early Warning & Risk Monitoring System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["*"]

# Database Configuration (Defaults to local SQLite path in data/landslide_system.db)
DATABASE_PATH="data/landslide_system.db"

# ML Model Paths
ML_MODEL_DIR="backend/ml_engine/models"
SPATIAL_MODEL_FILENAME="landslide_rf_model.joblib"
METADATA_FILENAME="model_metadata.json"

# Early Warning Empirical Thresholds
RAINFALL_YELLOW_THRESHOLD_MM=40.0
RAINFALL_ORANGE_THRESHOLD_MM=75.0
RAINFALL_RED_THRESHOLD_MM=120.0
SOIL_MOISTURE_CRITICAL_PCT=80.0
